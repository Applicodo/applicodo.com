  "narrative": {
    "northStar": "Open canvas",
    "overview": "The approved identity is “bold typography, generous spacing, graphite text, light backgrounds, and a confident blue accent.” It presents an independent developer through clear language and authentic iOS work. White and cool pale surfaces keep the experience open; strong Manrope headings and blue actions provide direction.\n\nThe system is spacious and direct. Product screens sit in simple device chrome, while content uses open columns and fine rules. Blue can form an entire contact surface as well as an action or highlighted phrase. The chosen first-surface composition and its approved comp remain in `docs/landing-brief.md`; they do not prescribe every future page layout.",
    "keyCharacteristics": [
      "Bold, tightly spaced sans-serif headings with relaxed body copy.",
      "Light surfaces, graphite text and a confident blue accent.",
      "Authentic app imagery, open content and restrained ruled rows.",
      "Quiet, optional motion and clearly visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Purposeful Blue Rule",
        "body": "Use blue to direct action, emphasize a short phrase or anchor a meaningful section. Its full-width contact use is part of the implemented world; do not impose an invented percentage limit.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Keep the interface in Manrope. The implemented system has no decorative display face or code-style monospace role.",
        "section": "typography"
      },
      {
        "name": "The Flat Content Rule",
        "body": "Keep ordinary prose and service rows flat and open. Device framing is a native part of the product presentation and retains its soft shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the light canvas, graphite typography and blue roles together as one identity.",
      "**Do** preserve original app screenshot proportions, descriptive alternatives and shipping asset provenance.",
      "**Do** use open columns, readable paragraph widths and fine rules for content hierarchy.",
      "**Do** preserve visible keyboard focus, labeled fields, announced feedback and reduced-motion behavior.",
      "**Do** let navigation, content and actions wrap or stack at the observed breakpoints."
    ],
    "donts": [
      "**Don't** replace real product work with stock team photography, invented dashboards, testimonials or statistics.",
      "**Don't** introduce decorative gradients, glass, code-style monospace, repeated icon cards or section numbering into this approved world.",
      "**Don't** turn the service rows into a reusable raised-card pattern.",
      "**Don't** hide key copy, actions or form fields to make a composition fit."
    ]
  }
}
