      "css": ".ds-header{min-height:100px;display:flex;align-items:center;justify-content:space-between;gap:2rem;color:var(--ink,#202328);font-family:Manrope,sans-serif;}.ds-wordmark{font-size:clamp(1.75rem,2.8vw,2.625rem);font-weight:800;letter-spacing:-0.04em;line-height:1;text-decoration:none;color:inherit;}.ds-nav{display:flex;align-items:center;gap:clamp(1.75rem,3.3vw,3.5rem);font-size:1.125rem;font-weight:600;}.ds-nav>a{color:inherit;text-decoration:none;}.ds-nav>a:not(.ds-nav-action):hover{text-decoration:underline;text-underline-offset:0.22em;}.ds-nav .ds-nav-action{display:inline-flex;align-items:center;justify-content:center;gap:1rem;padding:1.25rem 1.625rem;border:0;border-radius:10px;text-decoration:none;font-family:Manrope,sans-serif;font-size:1.125rem;line-height:1.5;font-weight:650;cursor:pointer;transition:background 180ms var(--ease-out,cubic-bezier(0.16,1,0.3,1)),color 180ms var(--ease-out,cubic-bezier(0.16,1,0.3,1)),box-shadow 180ms var(--ease-out,cubic-bezier(0.16,1,0.3,1));background:var(--blue,#2254ef);color:var(--paper,#ffffff);padding:0.9rem 1.75rem;}.ds-nav-action:hover{background:var(--blue-deep,#173fc2);}.ds-nav-action:active{box-shadow:inset 0 2px 4px #0b2b8640;}.ds-header a:focus-visible{outline:3px solid var(--blue,#2254ef);outline-offset:6px;}@media(min-width:901px){.ds-nav{font-size:clamp(1.125rem,1.3021vw,1.25rem);}.ds-nav .ds-nav-action{min-width:clamp(8.375rem,10.4167vw,10rem);min-height:clamp(3.5rem,4.2318vw,4.0625rem);padding:0.75rem 1.25rem;font-size:clamp(1.125rem,1.4323vw,1.375rem);}}@media(max-width:900px){.ds-header{min-height:90px;}.ds-nav{font-size:0.9375rem;gap:1.5rem;}.ds-nav .ds-nav-action{padding:0.7rem 1.1rem;}}@media(max-width:540px){.ds-header{min-height:80px;gap:0.75rem;}.ds-wordmark{font-size:1.75rem;}.ds-nav{gap:1rem;font-size:0.8125rem;}.ds-nav .ds-nav-action{padding:0.6rem 0.75rem;font-size:0.8125rem;border-radius:7px;}}@media(max-width:359px){.ds-header{flex-wrap:wrap;row-gap:1rem;padding-block:1.25rem 0.75rem